{
  "model_id": "industry_etf_rotation_v1",
  "model_name": "行业轮动 ETF V1",
  "version": "1.0.0",
  "status": "research_only_shadow",
  "instrument_type": "etf",
  "decision_timing": "post_close",
  "earliest_execution": "next_trade_day_open",
  "allow_cash": true,
  "maximum_selections": 3,
  "data_contract": {
    "sector_source": "tushare.moneyflow_ind_ths",
    "sector_lookback_trade_days": 20,
    "sector_persistence_trade_days": 5,
    "minimum_sector_history_days": 20,
    "etf_sources": [
      "tushare.fund_basic",
      "tushare.fund_daily",
      "tushare.fund_share",
      "tushare.fund_nav"
    ],
    "etf_lookback_trade_days": 60,
    "liquidity_lookback_trade_days": 20,
    "share_change_lookback_trade_days": 20,
    "minimum_etf_history_days": 60,
    "minimum_complete_universe_ratio": 1.0,
    "minimum_listing_days": 180,
    "minimum_average_amount_20d_yuan": 50000000,
    "maximum_absolute_premium_discount_pct": 2.0,
    "maximum_nav_staleness_calendar_days": 3,
    "opinion_source": "sector_opinion_daily",
    "timing_source": "market_timing_signal_daily.market_timing_v20",
    "missing_numeric_score": 50.0
  },
  "scoring": {
    "formula_contract": {
      "flow_strength": "cross_section_percentile_of_latest_mean_net_amount",
      "flow_persistence": "50pct_positive_flow_days_plus_50pct_days_at_or_above_60th_cross_section_percentile",
      "sector_price_trend": "clip_0_100(50 + 3 * compounded_return_5d_pct + 1.5 * compounded_return_20d_pct)",
      "opinion": "mean_latest_exact_alias_sector_score",
      "liquidity": "cross_section_percentile_of_average_amount_20d_yuan",
      "etf_price_trend": "clip_0_100(50 + 3 * return_5d_pct + 1.5 * return_20d_pct)",
      "share_change": "clip_0_100(50 + 2 * share_change_20d_pct)",
      "tracking": "clip_0_100(100 - 25 * absolute_premium_discount_pct)"
    },
    "sector_weights": {
      "flow_strength": 0.35,
      "flow_persistence": 0.25,
      "price_trend": 0.2,
      "opinion": 0.2
    },
    "etf_weights": {
      "liquidity": 0.35,
      "price_trend": 0.3,
      "share_change": 0.15,
      "tracking": 0.2
    },
    "combined_weights": {
      "sector": 0.7,
      "etf": 0.3
    },
    "minimum_sector_score": 58.0,
    "minimum_combined_score": 62.0
  },
  "risk_overlay": {
    "timing_model_id": "market_timing_v20",
    "timing_state_max_selections": {
      "cash": 0,
      "defensive": 1,
      "cautious": 1,
      "neutral": 2,
      "risk_on": 3,
      "strong_risk_on": 3,
      "missing": 0
    }
  },
  "forward_observation": {
    "entry_price": "next_trade_day_open",
    "exit_price": "horizon_trade_day_close",
    "horizons_trade_days": [1, 3, 5, 10, 20],
    "automatic_promotion": false
  },
  "guardrails": [
    "The ETF universe and every industry alias are explicit; runtime fuzzy matching is forbidden.",
    "This model never writes selection_result and never enters stock-selection statistics.",
    "This model never places orders or changes portfolio positions.",
    "A zero-selection day is a valid research observation.",
    "Missing sector, ETF, NAV, or timing evidence fails closed instead of being guessed.",
    "Historical observations may diagnose the model but never auto-tune weights or thresholds."
  ],
