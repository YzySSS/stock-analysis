# 股票分析项目 - 环境变量配置
# 推荐复制为 stock-analysis/.env 后再填写真实值
# 不要把真实密钥和数据库密码提交到 Git

# ============================================
# MySQL（app/ 新主线必填）
# ============================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=stock
DB_CHARSET=utf8mb4
DB_CONNECT_TIMEOUT_SECONDS=3
DB_READ_TIMEOUT_SECONDS=10
DB_WRITE_TIMEOUT_SECONDS=10
DB_POOL_ENABLED=true
DB_POOL_SIZE=4
DB_POOL_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=3

# API 持久异步任务（分钟线 Provider 在 spawn 子进程中执行，超时会终止）
DURABLE_INTRADAY_TIMEOUT_SECONDS=120
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true

# ============================================
# 共享缓存（默认使用进程内 TTL 缓存；memory 不需要额外服务）
# ============================================
CACHE_ENABLED=true
CACHE_BACKEND=memory
REDIS_CACHE_ENABLED=false
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_KEY_PREFIX=stock-analysis
# REDIS_URL=redis://127.0.0.1:6379/0
CACHE_REDIS_CONNECT_TIMEOUT_SECONDS=0.5
CACHE_REDIS_TIMEOUT_SECONDS=0.5
CACHE_REDIS_FALLBACK_TO_MEMORY=true

# 舆情快照生产任务稳定前保持 false；开启后选股只读最近完整快照。
USE_SENTIMENT_READ_MODEL=false

# ============================================
# SQLite（可选，默认使用项目内 data_cache）
# ============================================
# SQLITE_STOCK_HISTORY_PATH=/absolute/path/to/stock_history.db
# SQLITE_SENTIMENT_CACHE_PATH=/absolute/path/to/sentiment_cache.db

# ============================================
# Tushare 数据（可选，增强数据质量）
# ============================================
# TUSHARE_TOKEN=your_tushare_token
# 权限探针不自动读取该变量；运行时需显式传 --token-env TUSHARE_TOKEN。

# ============================================
# 飞书推送配置（按需）
# ============================================
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/your_token

# ============================================
# Tavily 新闻搜索（按需）
# ============================================
# TAVILY_API_KEY=tvly-your-key

# ============================================
# AI 分析配置（按需）
# ============================================
# OPENAI_API_KEY=your_api_key
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# ============================================
# 分析参数配置（按需）
# ============================================
DEFAULT_STOCKS=000001.SZ,000002.SZ,600519.SH
ENABLE_BACKTEST=true
NEWS_MAX_AGE_DAYS=3
SCHEDULE_TIME=50 8 * * 1-5
