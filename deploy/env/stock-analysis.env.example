# 复制到云服务器 root-only EnvironmentFile 后填写，禁止提交真实值。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=stock_app
DB_PASSWORD=replace_me
DB_NAME=stock
DB_CONNECT_TIMEOUT_SECONDS=3
DB_READ_TIMEOUT_SECONDS=10
DB_WRITE_TIMEOUT_SECONDS=10
DB_POOL_ENABLED=true
DB_POOL_SIZE=4
DB_POOL_MAX_OVERFLOW=0
DB_POOL_TIMEOUT_SECONDS=3

# Durable task worker: hard timeout for isolated intraday provider process
DURABLE_INTRADAY_TIMEOUT_SECONDS=120

# 首次上线保持 false；Redis 验证完成后再启用。
CACHE_ENABLED=true
CACHE_BACKEND=memory
REDIS_CACHE_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_DEFAULT_TTL_SECONDS=60
CACHE_KEY_PREFIX=stock-analysis
CACHE_REDIS_CONNECT_TIMEOUT_SECONDS=0.5
CACHE_REDIS_TIMEOUT_SECONDS=0.5
CACHE_REDIS_FALLBACK_TO_MEMORY=true
USE_SENTIMENT_READ_MODEL=false

# 只在云服务器填写真实 token/key。
TUSHARE_TOKEN=
TAVILY_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
