[Unit]
Description=Stock Analysis FastAPI service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/root/.openclaw/workspace/stock-analysis
Environment=PYTHONPATH=/root/.openclaw/workspace/stock-analysis
Environment=API_HOST=127.0.0.1
Environment=API_PORT=8000
ExecStartPre=/root/.openclaw/workspace/stock-analysis/.venv/bin/python -m app.orchestration.migrate --check
ExecStart=/root/.openclaw/workspace/stock-analysis/.venv/bin/python -m uvicorn app.api.main:app --app-dir /root/.openclaw/workspace/stock-analysis --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
