[Unit]
Description=Stock Analysis Backtest Worker
After=network-online.target mysql.service stock-analysis-api.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/stock-analysis/app.env
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/stock-analysis /var/log/stock-analysis
StateDirectory=stock-analysis
LogsDirectory=stock-analysis
UMask=0077
CapabilityBoundingSet=
RestrictSUIDSGID=true
User=stock-analysis
Group=stock-analysis
WorkingDirectory=/opt/stock-analysis/current
Environment=PYTHONPATH=/opt/stock-analysis/current
ExecStartPre=/opt/stock-analysis/current/.venv/bin/python -m app.orchestration.migrate --check
ExecStart=/opt/stock-analysis/current/.venv/bin/python -m app.backtest.worker --poll-seconds 3
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
